<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Download the real GoogleService-Info.plist for the iOS app from the Firebase console
	(same project as androidApp/google-services.json) and drop it in this folder as
	"GoogleService-Info.plist", then add it to the Xcode target. It's gitignored — every
	dev/machine uses their own, same convention as the Android google-services.json.
	-->
	<key>API_KEY</key>
	<string>REPLACE_ME</string>
	<key>BUNDLE_ID</key>
	<string>com.openly.app</string>
	<key>PROJECT_ID</key>
	<string>REPLACE_ME</string>
	<key>GOOGLE_APP_ID</key>
	<string>REPLACE_ME</string>
	<key>GCM_SENDER_ID</key>
	<string>REPLACE_ME</string>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
</dict>
</plist>
