rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Any signed-in user can read open users' docs — required for the radar's
    // bounding-box query. See README's "Privacy notes" for the tradeoff this implies.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /interests/{interestId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid != request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow delete: if false;
    }

    match /matches/{matchId} {
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      allow read: if isSignedIn() && request.auth.uid in resource.data.uids;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.uids;

      // Two distinct participant-writable shapes, kept separate so neither can smuggle in the
      // other's fields. Membership and creation time stay immutable under both, so nobody can
      // edit themselves into someone else's match.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.uids
        && (
          // 1. The denormalised last-message preview that drives the chat list and unread badge.
          //    You can only attribute a message to yourself.
          (
            changedKeys().hasOnly(['lastMessageText', 'lastMessageSenderUid', 'lastMessageAtMillis', 'lastMessageType'])
            && request.resource.data.lastMessageSenderUid == request.auth.uid
          )
          // 2. The typing ping. Either you claim it as yourself, or you clear it — you can never
          //    make it look like the other person is typing.
          || (
            changedKeys().hasOnly(['typingUid', 'typingAtMillis'])
            && (request.resource.data.typingUid == request.auth.uid || request.resource.data.typingUid == '')
          )
        );

      allow delete: if false;

      match /messages/{messageId} {
        function isParticipant() {
          return isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.uids;
        }
        function isAuthor() {
          return resource.data.senderUid == request.auth.uid;
        }
        function changedFields() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }
        // `get(field, default)` keeps these working on messages written before these fields existed.
        function oldReactions() {
          return resource.data.get('reactions', {});
        }
        function oldDeletedFor() {
          return resource.data.get('deletedFor', []);
        }

        allow read: if isParticipant();
        allow create: if isParticipant() && request.resource.data.senderUid == request.auth.uid;

        // Messages are mutable, but only in four tightly-scoped ways. Each branch pins exactly
        // which keys may change and who may change them, so e.g. a recipient can mark a message
        // read but can never rewrite its text.
        allow update: if isParticipant() && (
          // 1. Read receipt — stamped by the *recipient* on the sender's message.
          (
            changedFields().hasOnly(['readAtMillis'])
            && !isAuthor()
            && request.resource.data.readAtMillis is int
          )
          // 2. Edit — author only, and it must stay flagged as edited.
          || (
            changedFields().hasOnly(['text', 'editedAtMillis'])
            && isAuthor()
            && request.resource.data.editedAtMillis is int
            && request.resource.data.editedAtMillis > 0
          )
          // 3. Unsend for everyone — author only, one-way, and it must scrub the payload.
          || (
            changedFields().hasOnly(['deletedForEveryone', 'text', 'mediaUrl', 'reactions'])
            && isAuthor()
            && request.resource.data.deletedForEveryone == true
            && request.resource.data.text == ''
            && request.resource.data.mediaUrl == ''
          )
          // 4. Hide for me — either participant, append-only, and only your own uid.
          || (
            changedFields().hasOnly(['deletedFor'])
            && request.resource.data.deletedFor.hasAll(oldDeletedFor())
            && request.resource.data.deletedFor.hasOnly(oldDeletedFor().concat([request.auth.uid]))
          )
          // 5. React — either participant, but only your own key in the reactions map.
          || (
            changedFields().hasOnly(['reactions'])
            && request.resource.data.get('reactions', {}).diff(oldReactions())
                 .affectedKeys().hasOnly([request.auth.uid])
          )
        );

        allow delete: if false;
      }
    }
  }
}
