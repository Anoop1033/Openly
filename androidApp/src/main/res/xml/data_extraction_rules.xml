<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ splits what android:allowBackup used to cover. allowBackup="false" stops cloud
  backup, but device-to-device transfer is governed here and would otherwise still copy the
  anonymous Firebase credential onto a second phone. Both paths are excluded for the same reason:
  see the comment in AndroidManifest.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
