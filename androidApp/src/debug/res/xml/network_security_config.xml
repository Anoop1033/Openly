<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug-only: lets the app reach the Firebase Local Emulator Suite over plain HTTP.
         10.0.2.2 is the Android emulator's alias for the host machine; the 192.168.x.x entry is
         for physical devices talking to that machine over the LAN. Release builds get no
         cleartext exception at all. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.41</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
