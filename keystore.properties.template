# Copy to keystore.properties (which is gitignored) and fill in.
#
# Generate the key first -- one command, from the repo root:
#
#   keytool -genkeypair -v -keystore openly-upload.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias openly
#
# -validity 10000 is not arbitrary: Play requires an upload key valid past 22 Oct 2033, and 10000
# days clears that. keytool will ask for a password and for name/organisation -- the name fields
# are cosmetic and never shown to users, but the password is not recoverable.
#
# Then back up openly-upload.jks AND this file somewhere off this laptop. If both are lost, the
# Play listing can never be updated again; you would have to publish a new app under a new package
# name and every existing install would be stranded. (Play App Signing does allow a key reset by
# support request, but only if the app has already been published -- it is not a safety net for a
# key lost before first upload.)

storeFile=openly-upload.jks
storePassword=
keyAlias=openly
keyPassword=
